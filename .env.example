# Copy to .env and fill in. Never commit .env or put real values in this file.

# Developer Portal > Bot > Token (secret)
DISCORD_TOKEN=
# Developer Portal > General Information > Application ID
DISCORD_APP_ID=
# Discord > right-click your server > Copy Server ID (needs Developer Mode)
DISCORD_GUILD_ID=

# Optional
DATABASE_PATH=./data/aigis.db
LOG_LEVEL=info
